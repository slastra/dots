# Rosé Pine palette — hand-maintained (theme-sync generator removed)

width=300
height=150
margin=8
padding=15
border-size=2
border-radius=8

background-color=#26233A
text-color=#E0DEF4
border-color=#EBBCBA

progress-color=over #31748F

icons=1
max-icon-size=64
icon-location=left

default-timeout=10000
ignore-timeout=0

max-history=50

group-by=app-name
max-visible=5

on-notify=exec ~/.config/mako/scripts/lamp.sh info
on-button-left=invoke-default-action
on-button-right=exec ~/.config/mako/scripts/lamp.sh idle "$id"

[urgency=low]
border-color=#9CCFD8

[urgency=normal]
border-color=#EBBCBA

[urgency=critical]
border-color=#EB6F92
default-timeout=0
on-notify=exec ~/.config/mako/scripts/lamp.sh alert
