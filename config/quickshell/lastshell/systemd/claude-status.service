[Unit]
Description=claude-status: Claude Code session snapshot for lastshell
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.config/quickshell/lastshell/scripts/claude-status.py --daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
