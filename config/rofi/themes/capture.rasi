/*
 * Screen Capture Menu Theme
 * Matches existing rofi themes (Rosé Pine)
 */

configuration {
	font:							"Share Tech 16";
	icon-theme: 					"rose-pine-icons";
    disable-history:                false;
    fullscreen:                     false;
	hide-scrollbar: 				true;
	sidebar-mode: 					false;
}
window {
    background-color:               @bg;
    text-color:                     @fg;
	width:							15%;
    height:                         435px;
    location:                       center;
}

@import "colors.rasi"

@import "style.rasi"
