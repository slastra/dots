configuration {
	font:							"Share Tech 16";
	icon-theme: 					"rose-pine-icons";
    display-combi: 					"󰙵"";
    display-run: 					"run";
    display-drun: 					"open";
    combi-modi:                     "window,drun"; 
    drun-display-format:            "{name}";
    disable-history:                false;
    fullscreen:                     false;
	hide-scrollbar: 				true;
	sidebar-mode: 					false;
}
window {

    background-color:               @bg;
    text-color:                     @fg;

	width:							30%;
    height:                         800px;
    location:                       center;
}

@import "colors.rasi"
@import "style.rasi"
