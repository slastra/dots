window {
    transparency:                   "real";
	border:							2px;
	border-color:					#26233a;
    border-radius:                  8px;
}
prompt {
    enabled: 						true;
	margin: 						0px 16px 0px 0px;
	background-color: 				@al;
	font-weight:                    bold;
	text-color: 					@bar;
	font:							"Material\-Design\-Iconic\-Font 16";
}

entry {
    background-color:               @al;
    text-color:                     @bar;
    placeholder-color:              @bar;
    expand:                         true;
    horizontal-align:               0;
    placeholder:                    "Search...";
    padding:                        1px;
    blink:                          true;
}

inputbar {
	children: 						[ prompt, entry ];
    background-color:               @bg;
    text-color:                     @bar;
    expand:                         false;
	border:							0px;
    border-radius:                  0px;
	border-color:					@bg;
    margin:                         0px;
    padding:                        15px 0px 12px 25px;
}

listview {
    background-color:               @al;
    padding:                        0px;
    columns:                        1;
    lines:                          7;
    spacing:                        5px;
    cycle:                          true;
    dynamic:                        true;
    layout:                         vertical;
}

mainbox {
    background-color:               @al;
	border:							0px;
    border-radius:                  0px;
	border-color:					@ac;
    children:                       [ inputbar, listview ];
    spacing:                       	0px;
    padding:                        0px;
}

element {
    background-color:               @al;
    text-color:                     @fg;
    orientation:                    horizontal;
    border-radius:                  0px;
    padding:                        10px 20px;
}

element-icon {
    background-color:  @al;
    text-color: inherit;
    size:                           32px;
    border:                         0px;
    padding:                        0px 10px 0px 0px;
}

element-text {
    background-color:  @al;
    text-color: inherit;
    expand:                         true;
    horizontal-align:               0;
    vertical-align:                 0.5;
    margin:                         0px 2.5px 0px 2.5px;
}

element selected {
    background-color:               @bga;
    text-color:                     @ac;
	border:							0px;
    border-radius:                  0px;
    border-color:           	@bg;
}
