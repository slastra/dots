configuration {
	font:							"Share Tech 16";
	icon-theme: 					"rose-pine-icons";
    combi-modi:                     "window,drun"; 
    drun-display-format:            "{name}";
    disable-history:                false;
    fullscreen:                     false;
	hide-scrollbar: 				true;
	sidebar-mode: 					false;
}
window {
    background-color:               @bg;
    text-color:                     @fg;
	width:							20%;
    height:                         800px;
    location:                       center;

}

@import "colors.rasi"

@import "style.rasi"
