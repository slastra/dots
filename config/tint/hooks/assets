#!/usr/bin/env python3
"""Build the `Tint` icon and cursor theme from the current palette.

Run by `tint apply` (see targets.toml) after ~/.config/tint/out/palette.json
is written. One theme directory, ~/.local/share/icons/Tint, holds:

  icons        Papirus's folder and places icons redrawn in the scheme's
               accent. Everything else is inherited from Papirus-Dark or
               Papirus-Light, whichever suits the background.
  hyprcursors  The BreezeX cursor SVGs with fill and outline taken from the
               scheme (the darker of background/foreground fills, the lighter
               outlines), packed by hyprcursor-util.
  cursors      The same shapes rendered to Xcursor for GTK3, Qt and XWayland.

The animated wait/progress cursors are bitmaps and keep their original colors.
`assets --build-only` builds without touching the running session.
"""
import configparser, json, os, re, shutil, struct, subprocess, sys, tempfile
from pathlib import Path

HOME = Path.home()
PALETTE = HOME / ".config/tint/out/palette.json"
DEST = HOME / ".local/share/icons/Tint"
PAPIRUS = Path("/usr/share/icons/Papirus")
CURSOR_SRC = HOME / "Projects/Scratch/cursors/build-breezex/src"   # hyprcursor source tree
CURSOR_X = HOME / ".local/share/icons/BreezeX-RosePine/cursors"    # Xcursor base
CURSOR_SIZE = 36
XCURSOR_SIZES = [24, 32, 36, 48, 64, 72, 96]


def rgb(h): return [int(h[i:i + 2], 16) for i in (1, 3, 5)]
def hexc(c): return "#%02x%02x%02x" % tuple(round(max(0, min(255, v))) for v in c)
def mix(a, b, t): return hexc([x + (y - x) * t for x, y in zip(rgb(a), rgb(b))])
def luma(h): r, g, b = rgb(h); return (0.299 * r + 0.587 * g + 0.114 * b) / 255


def recolor(text, table):
    return re.sub(r"#[0-9a-fA-F]{6}\b", lambda m: table.get(m.group().lower(), m.group()), text)


# ---- icons

def build_icons(p, out):
    main = p["accent"]
    glyph = mix(main, "#000000", 0.62) if luma(main) > 0.35 else mix(main, "#ffffff", 0.7)
    table = {"#5294e2": main, "#4877b1": mix(main, "#000000", 0.22), "#1d344f": glyph}
    blue = re.compile(r"^(folder|user)-blue(-.+)?\.svg$")

    index = configparser.ConfigParser(interpolation=None, strict=False)
    index.optionxform = str
    index.read(PAPIRUS / "index.theme")
    # the symbolic places are monochrome and recolor themselves
    sections = [s for s in index.sections() if s.endswith("/places") and "symbolic" not in s]
    done = {}
    for section in sections:
        real = (PAPIRUS / section).resolve()
        target = out / section
        target.parent.mkdir(parents=True, exist_ok=True)
        if real in done:                      # 96x96/places is 48x48/places, and so on
            target.symlink_to(os.path.relpath(done[real], target.parent))
            continue
        done[real] = target
        target.mkdir()
        for entry in sorted(real.iterdir()):
            if entry.is_symlink():
                if blue.match(entry.resolve().name) and entry.resolve().parent == real:
                    (target / entry.name).symlink_to(os.readlink(entry))
            elif blue.match(entry.name) and "bluegrey" not in entry.name:
                (target / entry.name).write_text(recolor(entry.read_text(), table))

    base = "Papirus-Dark" if luma(p["background"]) < 0.5 else "Papirus-Light"
    lines = ["[Icon Theme]", "Name=Tint",
             f"Comment=Papirus with folders in the {p.get('name', 'current')} scheme (generated by tint)",
             f"Inherits={base},hicolor", "Example=folder",
             "Directories=" + ",".join(s for s in sections if "@" not in s),
             "ScaledDirectories=" + ",".join(s for s in sections if "@" in s), ""]
    for section in sections:
        lines.append(f"[{section}]")
        lines += [f"{k}={v}" for k, v in index[section].items()]
        lines.append("")
    (out / "index.theme").write_text("\n".join(lines))
    return base


# ---- cursors

def cursor_table(p):
    dark, light = sorted([p["background"], p["foreground"]], key=luma)
    return {"#191724": dark, "#e0def4": light, "#f2e9e1": light,
            "#ebbcba": p["accent"], "#eb6f92": p["crit"], "#9ccfd8": p["info"]}


def build_hyprcursor(p, out, work):
    src = work / "src"
    shutil.copytree(CURSOR_SRC, src, symlinks=True)
    table = cursor_table(p)
    for svg in src.rglob("*.svg"):
        svg.write_text(recolor(svg.read_text(), table))
    (src / "manifest.hl").write_text(
        "name = Tint\ndescription = BreezeX cursors in the current color scheme (generated by tint)\n"
        "version = 1\ncursors_directory = hyprcursors\n")
    packed = work / "packed"
    packed.mkdir()
    subprocess.run(["hyprcursor-util", "--create", str(src), "-o", str(packed)],
                   check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    theme = next(packed.iterdir())
    shutil.copy(theme / "manifest.hl", out / "manifest.hl")
    shutil.copytree(theme / "hyprcursors", out / "hyprcursors")
    return src


def build_xcursor(src, out, work):
    """Start from the stock Xcursor set, then replace every shape we have an
    SVG for with a render of the recolored one."""
    cursors = out / "cursors"
    shutil.copytree(CURSOR_X, cursors, symlinks=True)
    frames = work / "frames"
    frames.mkdir()
    for shape in sorted((src / "hyprcursors").iterdir()):
        svgs = list(shape.glob("*.svg"))
        target = cursors / shape.name
        if len(svgs) != 1 or not target.exists():
            continue
        meta = dict(re.findall(r"^(hotspot_[xy])\s*=\s*([\d.]+)", (shape / "meta.hl").read_text(), re.M))
        hx, hy = float(meta.get("hotspot_x", 0)), float(meta.get("hotspot_y", 0))
        config = []
        for size in XCURSOR_SIZES:
            png = frames / f"{shape.name}-{size}.png"
            subprocess.run(["rsvg-convert", "-w", str(size), "-h", str(size), str(svgs[0]), "-o", str(png)], check=True)
            config.append(f"{size} {round(hx * size)} {round(hy * size)} {png}")
        real = target.resolve()
        subprocess.run(["xcursorgen", "-", str(real)], input="\n".join(config) + "\n", text=True, check=True)


# ---- the running session

def run(*cmd):
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def announce(base):
    # Same theme name, new files: toolkits only look again when the setting
    # changes, so step off the name and back on.
    iface = "org.gnome.desktop.interface"
    run("gsettings", "set", iface, "icon-theme", base)
    run("gsettings", "set", iface, "icon-theme", "Tint")
    run("gsettings", "set", iface, "cursor-theme", "default")
    run("gsettings", "set", iface, "cursor-theme", "Tint")
    run("hyprctl", "setcursor", "Tint", str(CURSOR_SIZE))


def main():
    p = json.loads(PALETTE.read_text())
    DEST.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="tint-assets.") as tmp:
        work = Path(tmp)
        out = Path(tempfile.mkdtemp(prefix=".Tint.", dir=DEST.parent))
        try:
            base = build_icons(p, out)
            src = build_hyprcursor(p, out, work)
            build_xcursor(src, out, work)
            old = DEST.with_name(".Tint.old")
            shutil.rmtree(old, ignore_errors=True)
            if DEST.exists():
                DEST.rename(old)
            out.rename(DEST)
            os.chmod(DEST, 0o755)
            shutil.rmtree(old, ignore_errors=True)
        except BaseException:
            shutil.rmtree(out, ignore_errors=True)
            raise
    if "--build-only" not in sys.argv:
        announce(base)


if __name__ == "__main__":
    main()
