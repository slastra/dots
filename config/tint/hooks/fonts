#!/usr/bin/env python3
"""Hand the current font pair to the toolkits that keep fonts in their own
settings files.

Run by `tint apply` (see targets.toml) after ~/.config/tint/out/fonts.json
is written. kitty and lastshell take the pair through templates; this does
the rest, each as a one-line edit so the files stay their owners':

  GTK   gsettings (live for GTK 4 and portal apps), and gtk-font-name in the
        GTK 3 and 4 settings.ini and in ~/.gtkrc-2.0
  Qt    the general= and fixed= lines of qt6ct.conf and qt5ct.conf
  mpv   osd-font in mpv.conf and font_mono in script-opts/stats.conf

Running apps keep the font they started with, except kitty and GTK 4.
"""
import json, os, re, subprocess
from pathlib import Path

HOME = Path.home()
f = json.loads((HOME / ".config/tint/out/fonts.json").read_text())
if not f.get("name"):
    raise SystemExit(0)                 # no pair chosen: leave everything alone
mono, sans = f["mono"], f["sans"]
msize, ssize = "%g" % f["mono_size"], "%g" % f["sans_size"]


def edit(path, pattern, line):
    """Replace the one line matching `pattern`, atomically; skip a missing file."""
    path = HOME / path
    if not path.exists():
        return
    old = path.read_text()
    new = re.sub(pattern, lambda m: line, old, count=1, flags=re.M)
    if new != old:
        tmp = path.with_name(path.name + ".tint-tmp")
        tmp.write_text(new)
        os.chmod(tmp, path.stat().st_mode & 0o777)
        os.replace(tmp, path)


for ini in (".config/gtk-3.0/settings.ini", ".config/gtk-4.0/settings.ini"):
    edit(ini, r"^gtk-font-name=.*$", "gtk-font-name=%s %s" % (sans, ssize))
edit(".gtkrc-2.0", r'^gtk-font-name=.*$', 'gtk-font-name="%s %s"' % (sans, ssize))

# Qt's font strings: family, point size, then fields that differ by Qt version
for conf in (".config/qt6ct/qt6ct.conf", ".config/qt5ct/qt5ct.conf"):
    for key, family, size in (("general", sans, ssize), ("fixed", mono, msize)):
        edit(conf, r'^%s="[^,"]*,[^,"]*,' % key, '%s="%s,%s,' % (key, family, size))

edit(".config/mpv/mpv.conf", r'^osd-font=.*$', 'osd-font="%s"' % mono)
edit(".config/mpv/script-opts/stats.conf", r"^font_mono=.*$", "font_mono=%s" % mono)

for key, value in (("font-name", "%s %s" % (sans, ssize)), ("monospace-font-name", "%s %s" % (mono, msize))):
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", key, value],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
